<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      width: {{ width }}px;
      padding: {% if layout in ["tank_detail", "tank_compare"] %}30px{% else %}44px{% endif %};
      color: #18212f;
      background: #eef2f7;
      font-family: "Noto Sans SC", "Microsoft YaHei", "PingFang SC", sans-serif;
    }
    .report {
      overflow: hidden;
      border: 1px solid #dbe3ed;
      border-radius: 24px;
      background: #ffffff;
      box-shadow: 0 16px 48px rgba(26, 42, 68, 0.12);
    }
    .header {
      padding: {% if layout in ["tank_detail", "tank_compare"] %}24px 36px{% else %}34px 42px{% endif %};
      color: #ffffff;
      background: linear-gradient(135deg, #5268dc 0%, #704fca 100%);
    }
    .header h1 {
      margin: 0;
      font-size: {% if layout in ["tank_detail", "tank_compare"] %}40px{% else %}46px{% endif %};
      line-height: 1.25;
      letter-spacing: 2px;
    }
    .header p {
      margin: 10px 0 0;
      font-size: 22px;
      opacity: 0.82;
    }
    .content { padding: {% if layout in ["tank_detail", "tank_compare"] %}24px{% else %}30px{% endif %}; }
    .summary {
      margin: 0 0 20px;
      color: #43516a;
      font-size: 26px;
      font-weight: 600;
    }
    .table-wrap {
      overflow: hidden;
      border: 1px solid #dce4ee;
      border-radius: 16px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      background: #ffffff;
      font-size: 25px;
      line-height: 1.35;
    }
    th {
      padding: 20px 14px;
      color: #34435a;
      background: #edf2f8;
      font-weight: 700;
      white-space: nowrap;
    }
    td {
      padding: 18px 14px;
      border-top: 1px solid #e4eaf1;
      text-align: center;
      white-space: nowrap;
    }
    tbody tr:nth-child(even) { background: #f8fafc; }
    td:nth-child(2) { text-align: left; font-weight: 650; }
    .moe td:first-child { text-align: left; font-weight: 650; }
    .moe td:nth-child(2) { text-align: center; font-weight: 500; }
    .footer {
      margin: 20px 4px 0;
      color: #78869a;
      font-size: 21px;
      text-align: right;
    }
    .section {
      margin-top: 22px;
      padding: 26px 30px;
      border: 1px solid #e0e7f0;
      border-radius: 16px;
      background: #f9fbfd;
      font-size: 28px;
      font-weight: 500;
      line-height: 1.75;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .section:first-child { margin-top: 0; }
    .hero-gallery {
      display: flex;
      align-items: stretch;
      justify-content: center;
      gap: 0;
      flex: 1;
      width: 100%;
      min-width: 0;
      min-height: 280px;
      height: 280px;
    }
    .hero-item {
      position: relative;
      flex: 1;
      min-height: 280px;
      margin: 0;
      overflow: hidden;
      border-radius: 0;
      background: transparent;
    }
    .hero-item img {
      display: block;
      width: 100%;
      height: 280px;
      object-fit: contain;
      filter: drop-shadow(0 18px 18px rgba(25, 35, 55, 0.22));
    }
    .hero-label {
      position: absolute;
      left: 20px;
      bottom: 16px;
      padding: 7px 14px;
      border-radius: 999px;
      color: #fff;
      background: rgba(39, 49, 76, 0.82);
      font-size: 20px;
      font-weight: 700;
    }
    .tank-intro {
      display: flex;
      position: relative;
      align-items: stretch;
      margin-bottom: 20px;
      overflow: hidden;
      min-height: 280px;
      border: 1px solid #dce4ee;
      border-radius: 18px;
      background:
        radial-gradient(circle at 50% 38%, rgba(112, 79, 202, 0.20), transparent 48%),
        linear-gradient(145deg, #f8faff, #e8edf7);
    }
    .tank-intro-info {
      position: absolute;
      z-index: 2;
      top: 18px;
      left: 20px;
      width: fit-content;
      max-width: calc(100% - 40px);
      margin: 0;
      overflow: hidden;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
    }
    .tank-intro-info .card-body {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      padding: 8px 12px;
    }
    .tank-intro-info .data-row.intro-meta {
      justify-content: flex-start;
      flex: 0 0 auto;
      width: auto;
      padding: 3px 14px;
      font-size: 22px;
      border-right: 1px solid #dfe6ef;
      border-bottom: 0;
    }
    .tank-intro-info .data-row.intro-meta:last-child { border-right: 0; }
    .tank-intro-info .data-row.intro-meta .data-value {
      text-align: left;
    }
    .tank-intro.no-hero {
      min-height: 0;
      background: #fbfcfe;
    }
    .tank-intro.no-hero .tank-intro-info {
      position: static;
      width: 100%;
      max-width: none;
      box-shadow: none;
      backdrop-filter: none;
    }
    .card-grid {
      display: flex;
      gap: 20px;
      align-items: start;
    }
    .card-column {
      display: flex;
      flex: 1;
      min-width: 0;
      flex-direction: column;
      gap: 20px;
    }
    .data-card {
      width: 100%;
      margin: 0;
      overflow: hidden;
      border: 1px solid #dce4ee;
      border-radius: 18px;
      background: #fbfcfe;
    }
    .data-card h2 {
      margin: 0;
      padding: 14px 20px;
      color: #35445d;
      background: linear-gradient(90deg, #edf2fa, #f6f3fc);
      border-bottom: 1px solid #dce4ee;
      font-size: 27px;
    }
    .card-body { padding: 8px 20px 12px; }
    .data-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 18px;
      padding: 5px 0;
      color: #202b3d;
      border-bottom: 1px solid #edf1f6;
      font-size: 22px;
      font-weight: 600;
      line-height: 1.42;
    }
    .data-row:last-child { border-bottom: 0; }
    .data-label {
      color: #354258;
      font-weight: 600;
    }
    .data-value {
      color: #172031;
      font-weight: 750;
      text-align: right;
      overflow-wrap: anywhere;
    }
    .data-row.sub { padding-left: 18px; font-size: 20px; }
    .data-row.sub .data-label { color: #56647a; }
    .data-row.full .data-value {
      width: 100%;
      text-align: left;
      font-size: 23px;
    }
    .data-row.comparison-head {
      margin: 0 -20px 5px;
      padding: 7px 20px;
      background: #f1f4f9;
      border-bottom-color: #dfe6ef;
    }
  </style>
</head>
<body>
  <main class="report">
    <header class="header">
      <h1>{{ title }}</h1>
      {% if layout not in ["tank_detail", "tank_compare"] %}
      <p>坦克世界数据查询</p>
      {% endif %}
    </header>
    <div class="content">
      {% if table %}
      <p class="summary">{{ table.summary }}</p>
      <div class="table-wrap">
        <table class="{{ layout }}">
          <thead>
            <tr>
              {% for header in table.headers %}<th>{{ header }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in table.rows %}
            <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% for notice in table.notices %}
      <section class="section">{{ notice }}</section>
      {% endfor %}
      <p class="footer">{{ table.footer }}</p>
      {% elif cards %}
      <div class="tank-intro{% if not hero_images %} no-hero{% endif %}">
        {% if hero_images %}
        <div class="hero-gallery">
          {% for label, image_url in hero_images %}
          <figure class="hero-item">
            <img src="{{ image_url }}" alt="{{ label }}" referrerpolicy="no-referrer">
            <figcaption class="hero-label">{{ label }}</figcaption>
          </figure>
          {% endfor %}
        </div>
        {% endif %}
        <section class="tank-intro-info">
          <div class="card-body">
            {% for row in cards[0].rows %}
            <div class="data-row {{ row.kind }}">
              {% if row.label %}<span class="data-label">{{ row.label }}</span>{% endif %}
              <span class="data-value">{{ row.value }}</span>
            </div>
            {% endfor %}
          </div>
        </section>
      </div>
      <div class="card-grid {{ layout }}">
        {% for column in card_columns %}
        <div class="card-column">
          {% for card in column %}
          <section class="data-card">
            <h2>{{ card.title }}</h2>
            <div class="card-body">
              {% for row in card.rows %}
              <div class="data-row {{ row.kind }}">
                {% if row.label %}<span class="data-label">{{ row.label }}</span>{% endif %}
                <span class="data-value">{{ row.value }}</span>
              </div>
              {% endfor %}
            </div>
          </section>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      {% if card_footer %}<p class="footer">{{ card_footer }}</p>{% endif %}
      {% else %}
      {% for section in sections %}
      <section class="section">{{ section }}</section>
      {% endfor %}
      {% endif %}
    </div>
  </main>
</body>
</html>
